{
  "name": "aronim-bookstore-frontend",
  "private": true,
  "workspaces": [
    "applications/**",
    "libraries/**",
    "tools/**"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "clean": "lerna clean",
    "new:application": "node tools/generators/application",
    "new:library": "node tools/generators/library",
    "lint": "lerna run lint --stream --parallel",
    "start": "lerna run start --stream --parallel",
    "test": "lerna run test --stream"
  },
  "devDependencies": {
    "lerna": "^8.2.1"
  }
}
