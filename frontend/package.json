{
  "name": "aronim-bookstore-frontend",
  "private": true,
  "workspaces": [
    "applications/**",
    "libraries/**",
    "tools/**"
  ],
  "scripts": {
    "build:development": "lerna run build:development --stream",
    "build:production": "lerna run build:production --stream",
    "clean": "lerna clean",
    "new:application": "node tools/generators/application",
    "new:library": "node tools/generators/library",
    "lint": "lerna run lint --stream --parallel",
    "start": "lerna run start --stream --parallel",
    "test": "lerna run test --stream"
  },
  "devDependencies": {
    "lerna": "^8.2.1"
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b"
}
